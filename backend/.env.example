# Configuracion del backend Imagen Perfecta (copiar a .env si se quiere ajustar)

# ─── Base de datos MySQL ──────────────────────────────────────
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=imagen_perfecta

# ─── Detector de anomalias (ventana deslizante) ───────────────
# Ventana en SEGUNDOS por turno (PDF: configurable, no son ventas)
IP_VENTANA_MANANA=10
IP_VENTANA_TARDE=6
IP_VENTANA_NOCHE=3
# Umbral de transacciones dentro de la ventana -> POSIBLE_FRAUDE
IP_UMBRAL_TX=3

# ─── Seguridad de transacciones ───────────────────────────────
# Llave privada para HMAC-SHA256 (la del PDF, pagina 19)
IP_LLAVE_SECRETA=mi_llave_privada_123
# Hash autorizado que se le ENTREGA al profesor: funciona como
# credencial para sus transacciones con datos arbitrarios.
IP_HASH_AUTORIZADO=d94fa63f732e8d6b2dc28d408949d19f13b7568335969879d6bbde3777178756
